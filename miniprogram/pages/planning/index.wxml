<view class="page"><view class="eyebrow">BUDGET & REMINDERS</view><view class="page-title">预算与提醒</view>
  <view class="book-select card"><text>当前账本</text><picker range="{{books}}" range-key="name" value="{{bookIndex}}" bindchange="pickBook"><view>{{books[bookIndex].name || '请选择'}} ⌄</view></picker></view>
  <view class="tabs"><view data-tab="budgets" class="{{tab === 'budgets' ? 'active' : ''}}" bindtap="tab">预算</view><view data-tab="reminders" class="{{tab === 'reminders' ? 'active' : ''}}" bindtap="tab">提醒</view><view data-tab="recurring" class="{{tab === 'recurring' ? 'active' : ''}}" bindtap="tab">周期账单</view></view>
  <view wx:if="{{tab === 'budgets'}}"><picker mode="date" fields="month" value="{{month}}" bindchange="pickMonth"><view class="month-pick">{{month}} ⌄</view></picker><view class="card list"><view wx:if="{{!budgets.length}}" class="none">这个月还没有设置预算</view><view wx:for="{{budgets}}" wx:key="id" class="item"><view class="row-head"><text>{{item.category}}</text><text>¥{{item.spent}} / ¥{{item.amount}}</text></view><view class="progress"><view style="width: {{item.spent / item.amount * 100}}%"></view></view><text wx:if="{{role === 'OWNER'}}" class="action" data-id="{{item.id}}" bindtap="removeBudget">删除预算</text></view></view><view wx:if="{{role === 'OWNER'}}" class="card form"><view class="form-title">设置预算</view><picker range="{{expenseOptions}}" range-key="name" bindchange="budgetCategory"><view class="pick">{{budgetCategoryName}} ⌄</view></picker><input type="digit" placeholder="预算金额" value="{{budgetForm.amount}}" data-group="budgetForm" data-field="amount" bindinput="field" /><button class="primary" bindtap="saveBudget">保存预算</button></view></view>
  <view wx:if="{{tab === 'reminders'}}"><view class="card list"><view wx:if="{{!reminders.length}}" class="none">还没有提醒规则</view><view wx:for="{{reminders}}" wx:key="id" class="item"><view class="row-head"><text>{{item.title}}</text><text>{{item.active ? '启用' : '暂停'}}</text></view><view class="meta">{{item.kind === 'BOOKKEEPING' ? '记账提醒' : '账单到期'}} · {{item.recurrence}} · {{item.dueAt}}</view><text class="action" data-id="{{item.id}}" bindtap="toggleReminder">{{item.active ? '暂停' : '启用'}}</text></view></view><view class="card form"><view class="form-title">新增提醒</view><picker range="{{reminderKinds}}" bindchange="reminderKind"><view class="pick">{{reminderForm.kind === 'BOOKKEEPING' ? '记账提醒' : '账单到期提醒'}} ⌄</view></picker><input maxlength="80" placeholder="提醒标题，如信用卡还款" value="{{reminderForm.title}}" data-group="reminderForm" data-field="title" bindinput="field" /><picker mode="date" value="{{reminderForm.date}}" data-group="reminderForm" data-field="date" bindchange="field"><view class="pick">{{reminderForm.date}} ⌄</view></picker><picker mode="time" value="{{reminderForm.time}}" data-group="reminderForm" data-field="time" bindchange="field"><view class="pick">{{reminderForm.time}} ⌄</view></picker><picker range="{{reminderRecurrences}}" bindchange="reminderRecurrence"><view class="pick">{{reminderForm.recurrence === 'ONCE' ? '仅一次' : reminderForm.recurrence === 'DAILY' ? '每天' : '每月'}} ⌄</view></picker><input type="number" placeholder="提前天数，0–30" value="{{reminderForm.leadDays}}" data-group="reminderForm" data-field="leadDays" bindinput="field" /><button class="primary" bindtap="saveReminder">创建提醒</button></view></view>
  <view wx:if="{{tab === 'recurring'}}"><view wx:if="{{role !== 'OWNER'}}" class="none">只有账本创建者可管理周期账单</view><view wx:else><view class="section-title">待确认账单</view><view class="card list"><view wx:if="{{!pending.length}}" class="none">当前没有待确认账单</view><view wx:for="{{pending}}" wx:key="id" class="item"><view class="row-head"><text>{{item.purpose}}</text><text>¥{{item.amount}}</text></view><view class="meta">计划日期 {{item.scheduledOn}}</view><view class="actions"><text data-id="{{item.id}}" data-action="approve" bindtap="decide">确认入账</text><text data-id="{{item.id}}" data-action="dismiss" bindtap="decide">忽略</text></view></view></view><view class="section-title">每月模板</view><view class="card list"><view wx:for="{{recurring}}" wx:key="id" class="item"><view class="row-head"><text>{{item.purpose}}</text><text>¥{{item.amount}}</text></view><view class="meta">每月 {{item.dayOfMonth}} 日 · {{item.active ? '启用' : '暂停'}}</view><text class="action" data-id="{{item.id}}" bindtap="toggleRecurring">{{item.active ? '暂停' : '启用'}}</text></view></view><view class="card form"><view class="form-title">新增周期账单</view><picker range="{{transactionTypes}}" bindchange="recurringType"><view class="pick">{{recurringForm.type === 'EXPENSE' ? '支出' : '收入'}} ⌄</view></picker><input maxlength="40" placeholder="用途，如房租" value="{{recurringForm.purpose}}" data-group="recurringForm" data-field="purpose" bindinput="field" /><input type="digit" placeholder="金额" value="{{recurringForm.amount}}" data-group="recurringForm" data-field="amount" bindinput="field" /><picker range="{{recurringOptions}}" range-key="name" bindchange="recurringCategory"><view class="pick">{{recurringCategoryName}} ⌄</view></picker><input type="number" placeholder="每月生成日，1–31" value="{{recurringForm.dayOfMonth}}" data-group="recurringForm" data-field="dayOfMonth" bindinput="field" /><picker mode="date" fields="month" value="{{recurringForm.startMonth}}" data-group="recurringForm" data-field="startMonth" bindchange="field"><view class="pick">开始 {{recurringForm.startMonth}} ⌄</view></picker><input maxlength="500" placeholder="备注（选填）" value="{{recurringForm.note}}" data-group="recurringForm" data-field="note" bindinput="field" /><button class="primary" bindtap="saveRecurring">创建模板</button></view></view></view>
</view>
