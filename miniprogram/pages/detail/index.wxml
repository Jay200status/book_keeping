<view class="page">
  <view wx:if="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{record}}">
    <view class="eyebrow">TRANSACTION DETAIL</view><view class="page-title">账单详情</view>
    <view class="amount-card card"><view class="amount-caption">{{record.type === 'TRANSFER' ? '转账' : record.type === 'INCOME' ? '收入' : '支出'}}金额</view><view class="amount">{{record.type === 'INCOME' ? '+' : record.type === 'TRANSFER' ? '' : '-'}}¥{{record.amount}}</view><view class="source">{{record.source === 'OFFICIAL_ACCOUNT' ? '公众号自动记录' : record.source === 'ADMIN' ? '管理端记录' : '小程序记录'}}</view></view>
    <view wx:if="{{!editing}}" class="detail-card card"><view class="row"><text>用途</text><text class="value">{{record.purpose}}</text></view><view class="row"><text>分类</text><text class="value">{{record.category || '转账'}}</text></view><view class="row"><text>账户</text><text class="value">{{record.account || '未指定'}}</text></view><view class="row"><text>时间</text><text class="value">{{record.occurredAt}}</text></view><view class="row"><text>备注</text><text class="value">{{record.note || '无'}}</text></view></view>
    <view wx:else class="detail-card card editor"><view class="field"><text>金额</text><input type="digit" value="{{amount}}" bindinput="setAmount" /></view><view class="field"><text>用途</text><input maxlength="40" value="{{purpose}}" bindinput="setPurpose" /></view><view class="field"><text>分类</text><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="pickCategory"><view>{{categories[categoryIndex].name || '其他'}} ⌄</view></picker></view><view class="field"><text>账户</text><picker range="{{accounts}}" range-key="name" value="{{accountIndex}}" bindchange="pickAccount"><view>{{accounts[accountIndex].name || '未指定'}} ⌄</view></picker></view><view class="field"><text>日期</text><picker mode="date" value="{{date}}" bindchange="pickDate"><view>{{date}} ⌄</view></picker></view><view class="field"><text>时间</text><picker mode="time" value="{{time}}" bindchange="pickTime"><view>{{time}} ⌄</view></picker></view><view class="field"><text>备注</text><input maxlength="500" value="{{note}}" bindinput="setNote" /></view></view>
    <view wx:if="{{record.canEdit}}" class="actions"><button wx:if="{{!editing && record.kind !== 'transfer'}}" class="primary" bindtap="edit">编辑账单</button><button wx:if="{{editing}}" class="primary" loading="{{saving}}" bindtap="save">保存修改</button><button wx:if="{{editing}}" bindtap="cancel">取消</button><button class="delete" bindtap="remove">删除</button></view>
    <view wx:if="{{record.kind !== 'transfer'}}" class="comment-section"><view class="comment-title">成员留言</view><view class="card comment-card"><view wx:if="{{!comments.length}}" class="empty">还没有留言</view><view wx:for="{{comments}}" wx:key="id" class="comment"><view class="comment-meta">{{item.displayName}} · {{item.createdAt}}</view><view>{{item.body}}</view></view></view><view wx:if="{{record.canComment}}" class="comment-form"><input maxlength="500" placeholder="写一条留言" value="{{commentText}}" bindinput="setComment" /><button class="primary" loading="{{commentSaving}}" bindtap="addComment">发送</button></view></view>
  </view>
</view>
