<view class="page">
  <view class="eyebrow">LEDGER SETTINGS</view><view class="page-title">账本管理</view>
  <view class="tabs"><view data-tab="books" class="{{tab === 'books' ? 'active' : ''}}" bindtap="tab">账本</view><view data-tab="accounts" class="{{tab === 'accounts' ? 'active' : ''}}" bindtap="tab">账户</view><view data-tab="categories" class="{{tab === 'categories' ? 'active' : ''}}" bindtap="tab">分类</view><view data-tab="members" class="{{tab === 'members' ? 'active' : ''}}" bindtap="tab">成员</view></view>
  <view class="book-select card"><text>当前账本</text><picker range="{{books}}" range-key="name" value="{{bookIndex}}" bindchange="pickBook"><view>{{books[bookIndex].name || '请选择'}} ⌄</view></picker></view>
  <view wx:if="{{tab === 'books'}}">
    <view class="section-title">我的账本</view><view class="card list"><view wx:for="{{books}}" wx:key="id" class="item"><view><text class="item-name">{{item.name}}</text><view class="item-sub">{{item.role === 'OWNER' ? '我创建的' : item.role === 'EDITOR' ? '可记账' : '仅查看'}}</view></view><text wx:if="{{item.id === bookId}}" class="current">当前</text></view></view>
    <view class="section-title">新建账本</view><view class="card form"><input maxlength="100" placeholder="例如 旅行账本、家庭账本" value="{{newBookName}}" bindinput="bookName" /><button class="primary" bindtap="addBook">创建账本</button></view>
    <view class="section-title">加入共享账本</view><view class="card form"><input maxlength="12" placeholder="输入 12 位邀请码" value="{{joinCode}}" bindinput="joinInput" /><button bindtap="join">加入账本</button></view>
    <button class="report-link" bindtap="report">查看月度收支报告 →</button>
    <view class="section-title">快捷模板</view><view class="card list"><view wx:for="{{templates}}" wx:key="id" class="item"><text>{{item.name}} · {{item.purpose}}</text><text class="action" data-id="{{item.id}}" bindtap="deleteTemplate">删除</text></view><view wx:if="{{!templates.length}}" class="none">可在记账页保存常用模板</view></view>
  </view>
  <view wx:if="{{tab === 'accounts'}}">
    <view class="asset-overview card"><view><text>总资产</text><strong>¥{{assetTotal}}</strong></view><view><text>总负债</text><strong>¥{{liabilityTotal}}</strong></view><view><text>净资产</text><strong>¥{{netAssets}}</strong></view></view>
    <view class="section-title">资金账户</view><view class="card list"><view wx:for="{{accounts}}" wx:key="id" class="item"><view><text class="item-name">{{item.name}}</text><view class="item-sub">{{item.kind === 'LIABILITY' ? '负债' : '资产'}} · {{item.active ? '使用中' : '已停用'}}</view></view><view class="right"><text>¥{{item.balance}}</text><text wx:if="{{role === 'OWNER'}}" class="action" data-id="{{item.id}}" bindtap="editAccount">编辑</text><text wx:if="{{role === 'OWNER'}}" class="action" data-id="{{item.id}}" bindtap="toggleAccount">{{item.active ? '停用' : '启用'}}</text></view></view><view wx:if="{{!accounts.length}}" class="none">还没有资金账户</view></view>
    <view wx:if="{{role === 'OWNER'}}" class="card form spaced"><view class="form-title">{{accountForm.id ? '编辑账户' : '新增账户'}}</view><input maxlength="50" placeholder="账户名称，如微信钱包" value="{{accountForm.name}}" data-field="name" bindinput="accountInput" /><view class="switch-row">负债账户<switch checked="{{accountForm.kind === 'LIABILITY'}}" bindchange="accountKind" color="#72ad80" /></view><input type="digit" placeholder="期初余额" value="{{accountForm.openingBalance}}" data-field="openingBalance" bindinput="accountInput" /><button class="primary" bindtap="saveAccount">保存账户</button></view>
  </view>
  <view wx:if="{{tab === 'categories'}}">
    <view class="section-title">自定义分类</view><view class="mini-tabs"><text class="{{categoryType === 'EXPENSE' ? 'selected' : ''}}" data-type="EXPENSE" bindtap="categoryType">支出</text><text class="{{categoryType === 'INCOME' ? 'selected' : ''}}" data-type="INCOME" bindtap="categoryType">收入</text></view><view class="card list"><view wx:for="{{categories}}" wx:key="id" wx:if="{{item.type === categoryType}}" class="item"><view><text class="item-name">{{item.icon}} {{item.name}}</text><view class="item-sub">排序 {{item.sortOrder}} · {{item.active ? '使用中' : '已停用'}}</view></view><view wx:if="{{role === 'OWNER'}}" class="right"><text class="action" data-id="{{item.id}}" bindtap="editCategory">编辑</text><text class="action" data-id="{{item.id}}" bindtap="toggleCategory">{{item.active ? '停用' : '启用'}}</text></view></view></view>
    <view wx:if="{{role === 'OWNER'}}" class="card form spaced"><view class="form-title">{{categoryForm.id ? '编辑分类' : '新增分类'}}</view><input maxlength="50" placeholder="分类名称" value="{{categoryForm.name}}" data-field="name" bindinput="categoryInput" /><input maxlength="32" placeholder="图标，例如 🍜" value="{{categoryForm.icon}}" data-field="icon" bindinput="categoryInput" /><input type="number" placeholder="排序数字" value="{{categoryForm.sortOrder}}" data-field="sortOrder" bindinput="categoryInput" /><button class="primary" bindtap="saveCategory">保存分类</button></view>
  </view>
  <view wx:if="{{tab === 'members'}}">
    <view class="section-title">账本成员</view><view class="card list"><view wx:for="{{members}}" wx:key="id" class="item"><view><text class="item-name">{{item.displayName}}</text><view class="item-sub">#{{item.id}} · {{item.role === 'OWNER' ? '创建者' : item.role === 'EDITOR' ? '可记账' : '仅查看'}}</view></view><text wx:if="{{role === 'OWNER' && item.role !== 'OWNER'}}" class="action" data-id="{{item.id}}" bindtap="memberAction">管理</text></view></view>
    <view wx:if="{{role === 'OWNER'}}" class="card form spaced"><view class="form-title">邀请成员</view><view class="invite-buttons"><button data-role="EDITOR" bindtap="invite">邀请可记账成员</button><button data-role="VIEWER" bindtap="invite">邀请仅查看成员</button></view><view wx:if="{{inviteCode}}" class="invite-code">邀请码 {{inviteCode}}<view>已复制，24 小时内有效且只能使用一次</view></view></view>
  </view>
</view>
