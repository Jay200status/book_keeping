<view class="page">
  <view class="topline"><view><text class="eyebrow">MY LEDGER</text><view class="page-title">账单</view></view><view class="dot-mark">¥</view></view>
  <view class="book-row"><picker range="{{books}}" range-key="name" value="{{bookIndex}}" bindchange="pickBook"><view>{{books[bookIndex].name || '我的账本'}} ⌄</view></picker><text bindtap="manage">管理账本与账户 →</text></view>
  <swiper wx:if="{{banners.length}}" class="banner-swiper" indicator-dots autoplay interval="5000"><swiper-item wx:for="{{banners}}" wx:key="id"><view class="banner card" data-id="{{item.id}}" bindtap="openBanner"><view>{{item.title}}</view><text>{{item.body}}</text></view></swiper-item></swiper>
  <view class="summary card">
    <view class="periods"><view class="period {{period === 'year' ? 'chosen' : ''}}" data-period="year" bindtap="setPeriod">年</view><view class="period {{period === 'month' ? 'chosen' : ''}}" data-period="month" bindtap="setPeriod">月</view><view class="period {{period === 'day' ? 'chosen' : ''}}" data-period="day" bindtap="setPeriod">日</view></view>
    <view class="summary-label">{{title}}总支出</view><view class="amount"><text class="currency">¥</text>{{expense}}</view>
    <view class="income-line">总收入 ¥{{income}}</view>
    <view class="date-row"><view class="arrow" data-offset="-1" bindtap="shift">‹</view><picker mode="date" value="{{date}}" bindchange="pickDate"><view class="date-picker">{{title}} <text>⌄</text></view></picker><view class="arrow" data-offset="1" bindtap="shift">›</view></view>
  </view>
  <view wx:if="{{budgets.length}}" class="budget-box card"><view class="budget-title">预算执行</view><view wx:for="{{budgets}}" wx:key="id" class="budget-item"><text>{{item.category}}</text><text>¥{{item.spent}} / ¥{{item.amount}}</text></view></view>
  <view class="section-head"><text>收支明细</text><text class="count">{{records.length}} 笔</text></view>
  <view class="filters"><input placeholder="搜索用途或备注" value="{{search}}" bindinput="setSearch" confirm-type="search" bindconfirm="load" /><button bindtap="load">搜索</button></view>
  <scroll-view scroll-x class="filter-scroll"><view class="filter-pickers"><picker range="{{typeLabels}}" value="{{typeIndex}}" bindchange="pickType"><view>{{typeLabels[typeIndex]}} ⌄</view></picker><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="pickCategory"><view>{{categories[categoryIndex].name || '全部分类'}} ⌄</view></picker><picker range="{{accounts}}" range-key="name" value="{{accountIndex}}" bindchange="pickAccount"><view>{{accounts[accountIndex].name || '全部账户'}} ⌄</view></picker><picker range="{{members}}" range-key="displayName" value="{{memberIndex}}" bindchange="pickMember"><view>{{members[memberIndex].displayName || '全部成员'}} ⌄</view></picker></view></scroll-view>
  <view wx:if="{{loading}}" class="empty">正在加载账单…</view><view wx:elif="{{error}}" class="empty" bindtap="load">{{error}}<view>点此重试</view></view><view wx:elif="{{records.length === 0}}" class="empty">这段时间还没有账单<view>点下方「添加」记录第一笔</view></view>
  <view wx:else class="list card"><view wx:for="{{records}}" wx:key="id" class="record" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openDetail"><view class="record-icon">{{item.icon}}</view><view class="record-main"><view class="purpose">{{item.purpose}}</view><view class="when">{{item.day}} · {{item.time}} · {{item.category || '转账'}}</view></view><view class="record-money {{item.type === 'INCOME' ? 'positive' : ''}}">{{item.type === 'INCOME' ? '+' : item.type === 'TRANSFER' ? '' : '-'}}¥{{item.amount}}</view><view class="chevron">›</view></view></view>
</view>
