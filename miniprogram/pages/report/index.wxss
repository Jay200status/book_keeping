.eyebrow{margin-top:10rpx;color:#8da499;font-size:20rpx;letter-spacing:4rpx;font-weight:700}.page-title{font-size:52rpx;font-weight:700;margin:8rpx 0}.book-name{font-size:24rpx;color:#8da18f;margin-bottom:28rpx}.tabs{display:flex;background:#e8f1e8;border-radius:20rpx;padding:6rpx;width:430rpx}.tabs view{flex:1;text-align:center;padding:13rpx;color:#879989;font-size:24rpx}.tabs .selected{background:white;border-radius:16rpx;color:#3c744b;font-weight:700}.date-select{margin:25rpx 0;color:#58775f;font-size:26rpx}.totals{display:flex;gap:16rpx}.totals .card{flex:1;padding:29rpx;display:grid;gap:10rpx}.totals text{color:#8e9e91;font-size:23rpx}.totals strong{color:#365b3f;font-size:30rpx}.section-title{font-size:30rpx;font-weight:700;margin:40rpx 0 18rpx}.chart-card{padding:23rpx 29rpx}.category{padding:15rpx 0}.category-head{display:flex;justify-content:space-between;color:#607766;font-size:23rpx}.bar{height:12rpx;border-radius:20rpx;background:#edf4ed;margin-top:12rpx;overflow:hidden}.bar view{height:100%;background:#81b78e;border-radius:20rpx}.month-row{padding:18rpx 0;border-bottom:1rpx solid #edf1ed;display:flex;justify-content:space-between;color:#718774;font-size:22rpx}.month-row:last-child{border:0}.calendar{padding:18rpx}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.calendar-week{text-align:center;color:#6f8874;font-size:22rpx;padding-bottom:15rpx}.calendar-day{min-height:92rpx;border-top:1rpx solid #edf2eb;padding:8rpx 2rpx;display:flex;flex-direction:column;gap:4rpx;overflow:hidden}.calendar-day.blank{background:#fafcf9}.day-number{font-size:23rpx;color:#42604a;font-weight:700}.day-income,.day-expense{font-size:16rpx;white-space:nowrap}.day-income{color:#4d9872}.day-expense{color:#d37b67}
