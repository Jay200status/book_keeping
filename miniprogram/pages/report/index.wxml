<view class="page"><view class="eyebrow">FINANCIAL REPORT</view><view class="page-title">收支报告</view><view class="book-name">{{bookName}}</view>
  <view class="tabs"><view class="{{mode === 'month' ? 'selected' : ''}}" data-mode="month" bindtap="setMode">月度</view><view class="{{mode === 'year' ? 'selected' : ''}}" data-mode="year" bindtap="setMode">年度</view><view class="{{mode === 'calendar' ? 'selected' : ''}}" data-mode="calendar" bindtap="setMode">日历</view></view>
  <picker wx:if="{{mode !== 'year'}}" mode="date" fields="month" value="{{month}}" bindchange="pickMonth"><view class="date-select">{{month}} ⌄</view></picker><picker wx:else mode="date" fields="year" value="{{year}}" bindchange="pickYear"><view class="date-select">{{year}} 年 ⌄</view></picker>
  <view wx:if="{{mode === 'calendar'}}" class="card calendar"><view class="calendar-grid calendar-week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view wx:for="{{calendarDays}}" wx:key="key" class="calendar-day {{item.blank ? 'blank' : ''}}"><text wx:if="{{!item.blank}}" class="day-number">{{item.day}}</text><text wx:if="{{item.income}}" class="day-income">+{{item.income}}</text><text wx:if="{{item.expense}}" class="day-expense">-{{item.expense}}</text></view></view><view wx:if="{{!calendarDays.length}}" class="empty">暂无日历数据</view></view>
  <block wx:else><view class="totals"><view class="card"><text>收入</text><strong>+¥{{income}}</strong></view><view class="card"><text>支出</text><strong>-¥{{expense}}</strong></view></view>
  <view class="section-title">支出分类占比</view><view class="card chart-card"><view wx:if="{{!categories.length}}" class="empty">暂无支出数据</view><view wx:for="{{categories}}" wx:key="name" class="category"><view class="category-head"><text>{{item.name}}</text><text>¥{{item.amount}} · {{item.percent}}%</text></view><view class="bar"><view style="width: {{item.percent}}%"></view></view></view></view></block>
  <view wx:if="{{mode === 'year'}}"><view class="section-title">每月趋势</view><view class="card chart-card"><view wx:for="{{months}}" wx:key="month" class="month-row"><text>{{item.month}} 月</text><text>收入 ¥{{item.income}}</text><text>支出 ¥{{item.expense}}</text></view></view></view>
</view>
