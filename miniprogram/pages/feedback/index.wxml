<view class="page"><view class="eyebrow">FEEDBACK</view><view class="page-title">意见反馈</view><view class="card form"><input maxlength="80" placeholder="标题" value="{{subject}}" bindinput="subject" /><textarea maxlength="1000" placeholder="请描述你的建议或遇到的问题" value="{{content}}" bindinput="content" /><button class="primary" loading="{{saving}}" bindtap="send">提交反馈</button></view><view class="section-title">我的反馈</view><view class="card list"><view wx:if="{{!items.length}}" class="empty">还没有反馈记录</view><view wx:for="{{items}}" wx:key="id" class="item"><view class="title">{{item.subject}} <text>{{item.status === 'RESOLVED' ? '已回复' : '处理中'}}</text></view><view class="content">{{item.content}}</view><view wx:if="{{item.response}}" class="response">回复：{{item.response}}</view><view class="date">{{item.createdAt}}</view></view></view></view>
